// УРОК 1: питание и движение. ОТВЕТЫ к заданиям TODO
// Iskra Uno + Motor Shield: у каждого мотора пин направления (HIGH / LOW) и пин скорости (ШИМ 0-255)

#define L_DIR 7   // левый мотор – канал M2
#define L_PWM 6
#define R_DIR 4   // правый мотор – канал M1
#define R_PWM 5

void setup() {
  pinMode(L_DIR, OUTPUT);  // все пины управляют нагрузкой – режим OUTPUT
  pinMode(L_PWM, OUTPUT);
  pinMode(R_DIR, OUTPUT);
  pinMode(R_PWM, OUTPUT);
}

// left, right – скорость от -255 до 255, знак задает направление вращения
void motors(int16_t left, int16_t right) {
  left = constrain(left, -255, 255);    // ШИМ не бывает больше 255
  right = constrain(right, -255, 255);
  // TODO 1 (ответ): моторы стоят зеркально и подключены одинаково (зеленый на «+», черный на «−»),
  // поэтому левый для движения вперед крутится в обратную сторону – сравнение наоборот
  digitalWrite(L_DIR, left < 0);
  digitalWrite(R_DIR, right > 0);       // направление: true – HIGH, false – LOW
  analogWrite(L_PWM, abs(left));        // скорость – модуль числа
  analogWrite(R_PWM, abs(right));
}

void loop() {
  // TODO 2 (ответ): моторы немного разные – скорости подобраны руками, чтобы робот ехал прямо
  // (числа свои для каждого робота; в уроке 2 регулятор выровняет робота и без этой подгонки)
  // TODO 3 (ответ): разворот на месте – колеса крутятся в разные стороны: motors(150, -150)
  // TODO 4 (ответ): квадрат – прямо, поворот на 90 градусов, четыре раза; время поворота подобрать
  for (uint8_t i = 0; i < 4; i++) {
    motors(138, 150);   // прямо: левый у этого робота быстрее – убавили
    delay(1500);
    motors(150, -150);  // поворот на месте направо
    delay(450);
  }

  motors(0, 0);
  while (true) {}  // стоп навсегда: loop() больше не повторится
}
